# Prints only. A package must not seal secrets or edit /etc/pam.d by itself:
# sealing needs the user's keyring password typed on a terminal, and the PAM
# edits need consent for a login-critical file.
post_install() {
  cat <<'EOF'
==> Files are installed. Nothing is configured yet.
==> Run, as your own user:
==>     tpm-keyring-unlock-configure
==> It seals your keyring password into the TPM and wires up PAM, asking
==> before each change. Undo with tpm-keyring-unlock-deconfigure.
EOF
}

# tpm-keyring-unlock-configure may have loaded the SELinux module, which lets
# every process in GDM's domain open the TPM (README.md, "SELinux"). With the
# package gone no helper is left to need it.
post_remove() {
  if command -v semodule >/dev/null 2>&1 \
    && semodule -l 2>/dev/null | grep -qx tpm_keyring_unlock; then
    semodule -r tpm_keyring_unlock >/dev/null 2>&1 || true
  fi
}

post_upgrade() {
  echo "==> Run tpm-keyring-unlock-configure once after an upgrade: it re-checks"
  echo "==> the PAM stacks an older version wired, and takes the helper back"
  echo "==> out of any the current checks refuse. Answer n at 'Overwrite?' to"
  echo "==> keep your sealed secret."
  echo "==> Re-seal only after a Secure Boot or keyring password change:"
  echo "==>     tpm-keyring-seal"
}
