<!--
  Runs on the OBS server at commit time, not inside the build root: the
  buildtime variants need obs-service-* packages that Debian and Ubuntu base
  projects do not carry, which left every deb target "unresolvable".

  This fetches exactly the tarball GitHub publishes for the tag - the same
  artifact the AUR checksum pins - so all targets consume one identical file.
  New release: change the tag in <path> and in the spec/changelog.
-->
<services>
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">github.com</param>
    <param name="path">/dmitriitimoshenko/tpm-keyring-unlock/archive/refs/tags/v1.4.1.tar.gz</param>
    <param name="filename">tpm-keyring-unlock-1.4.1.tar.gz</param>
  </service>
</services>
